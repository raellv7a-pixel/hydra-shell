<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>name</key><string>Hydra</string>
  <key>settings</key>
  <array>
    <dict>
      <key>settings</key>
      <dict>
        <key>foreground</key><string>{{colors.terminal_foreground.default.hex}}</string>
        <key>background</key><string>{{colors.terminal_background.default.hex}}</string>
        <key>caret</key><string>{{colors.terminal_cursor.default.hex}}</string>
        <key>selection</key><string>{{colors.terminal_selection_background.default.hex}}</string>
        <key>selectionForeground</key><string>{{colors.terminal_selection_foreground.default.hex}}</string>
        <key>lineHighlight</key><string>{{colors.surface_container_low.default.hex}}</string>
      </dict>
    </dict>
    <dict>
      <key>scope</key><string>comment, punctuation.definition.comment</string>
      <key>settings</key><dict><key>foreground</key><string>{{colors.terminal_bright_black.default.hex}}</string><key>fontStyle</key><string>italic</string></dict>
    </dict>
    <dict>
      <key>scope</key><string>string, markup.inline.raw</string>
      <key>settings</key><dict><key>foreground</key><string>{{colors.terminal_normal_green.default.hex}}</string></dict>
    </dict>
    <dict>
      <key>scope</key><string>keyword, storage, markup.heading</string>
      <key>settings</key><dict><key>foreground</key><string>{{colors.terminal_normal_blue.default.hex}}</string></dict>
    </dict>
    <dict>
      <key>scope</key><string>entity.name.function, support.function</string>
      <key>settings</key><dict><key>foreground</key><string>{{colors.terminal_normal_cyan.default.hex}}</string></dict>
    </dict>
    <dict>
      <key>scope</key><string>entity.name.type, entity.name.class, support.type</string>
      <key>settings</key><dict><key>foreground</key><string>{{colors.terminal_normal_yellow.default.hex}}</string></dict>
    </dict>
    <dict>
      <key>scope</key><string>constant, constant.numeric, constant.language</string>
      <key>settings</key><dict><key>foreground</key><string>{{colors.terminal_normal_magenta.default.hex}}</string></dict>
    </dict>
    <dict>
      <key>scope</key><string>invalid, markup.deleted, entity.name.tag</string>
      <key>settings</key><dict><key>foreground</key><string>{{colors.terminal_normal_red.default.hex}}</string></dict>
    </dict>
    <dict>
      <key>scope</key><string>markup.inserted</string>
      <key>settings</key><dict><key>foreground</key><string>{{colors.terminal_normal_green.default.hex}}</string></dict>
    </dict>
  </array>
</dict>
</plist>
