{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "color": {
      "1": "{{colors.primary.default.hex}}",
      "2": "{{colors.tertiary.default.hex}}"
    }
  },
  "display": {
    "color": {
      "keys": "{{colors.primary.default.hex}}",
      "title": "{{colors.secondary.default.hex}}",
      "output": "{{colors.on_surface.default.hex}}",
      "separator": "{{colors.outline.default.hex}}"
    },
    "percent": {
      "color": {
        "green": "{{colors.secondary.default.hex}}",
        "yellow": "{{colors.tertiary.default.hex}}",
        "red": "{{colors.error.default.hex}}"
      }
    }
  }
}
